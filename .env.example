# Template only — NEVER put real values in this file. It is committed to a
# public repo. Real credentials go in .env, which is gitignored.
#
#   cp .env.example .env    then edit .env
#
# Create the token at https://hub.docker.com -> Account Settings ->
# Personal access tokens, with "Read & Write" scope. Use a token, not your
# account password.
#
# In CI these live in GitHub repository secrets instead:
#   gh secret set DOCKERHUB_USERNAME
#   gh secret set DOCKERHUB_TOKEN

DOCKERHUB_USERNAME=your-docker-hub-username
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx
