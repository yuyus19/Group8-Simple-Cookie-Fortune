# Example kubeconfig, safe to commit because every secret value is a
# placeholder.
#
# NEVER commit a real kubeconfig. A real one carries client-key-data, which is
# a private key that grants whoever holds it the same rights you have on the
# cluster. This repository is public, so committing it would hand the cluster
# to anyone who reads it.
#
# The real file belongs in a repository secret instead, which is exactly what
# 04-cd asks for:
#
#   cat ~/.kube/config | base64 -w0
#
# Save that output as a secret called KUBECONFIG, or let
# scripts/set-kubeconfig-secret.sh do it for you.
#
# .github/workflows/cd.yml reads that secret, and scripts/deploy.sh writes it
# back to disk at deploy time.
#
# One thing to watch out for: the cluster in the "server" line has to be
# reachable from a GitHub runner. A local Docker Desktop or kind cluster
# answers on kubernetes.docker.internal or 127.0.0.1, which mean nothing on
# someone else's machine, so those will not work here.

apiVersion: v1
kind: Config
preferences: {}

clusters:
  - name: fortune-cluster
    cluster:
      # Must be an address the internet can resolve and reach.
      server: https://REPLACE-WITH-YOUR-CLUSTER-HOST:6443
      certificate-authority-data: BASE64_CLUSTER_CA_CERTIFICATE

users:
  - name: fortune-deployer
    user:
      client-certificate-data: BASE64_CLIENT_CERTIFICATE
      client-key-data: BASE64_CLIENT_PRIVATE_KEY

contexts:
  - name: fortune
    context:
      cluster: fortune-cluster
      user: fortune-deployer
      namespace: fortune

current-context: fortune
